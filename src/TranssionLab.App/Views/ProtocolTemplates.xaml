<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pages="clr-namespace:TranssionLab.ViewModels.Pages;assembly=TranssionLab.ViewModels">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/TranssionLab;component/Themes/FluentDarkTheme.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- PAGE 6: MEDIATEK TOOLS (Section 2B) -->
  <DataTemplate DataType="{x:Type pages:MediaTekToolsViewModel}">
    <StackPanel>
      <Border Style="{StaticResource FluentCardStyle}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Scan MediaTek USB" Command="{Binding ScanMtkEndpointsCommand}" Style="{StaticResource SecondaryButtonStyle}" />
          <StackPanel>
            <TextBlock Text="MediaTek BROM / Preloader Catch &amp; Handshake" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,4" />
            <TextBlock Text="Step 1: Click an operation below (Console logs instructions + 'Waiting for USB device...'). Step 2: Power OFF phone and plug USB cable — catches VCOM (0E8D) immediately, handshakes device, and stops battery charging."
                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource FluentCardStyle}">
        <StackPanel>
          <TextBlock Text="1-Click MediaTek VCOM Operations (Logs Instructions -&gt; Waiting for USB -&gt; Handshake)" Style="{StaticResource SectionHeadingStyle}" />
          <WrapPanel Margin="0,0,0,12">
            <Button Content="⚡ Catch &amp; Handshake BROM / Preloader (0xA0)"
                    Command="{Binding ProbeHandshakeCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,0,8,8" />
            <Button Content="🧭 Boot Preloader to META Mode"
                    Command="{Binding BootPreloaderToMetaCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,8" />
            <Button Content="🚀 Boot Preloader to Fastboot Mode"
                    Command="{Binding BootPreloaderToFastbootCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,8" />
            <Button Content="🏭 Boot Preloader to Factory Mode"
                    Command="{Binding BootPreloaderToFactoryCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,8" />
            <Button Content="🔓 Release Held VCOM"
                    Command="{Binding ReleaseHeldMtkPortCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,0,8" />
          </WrapPanel>

          <TextBlock Text="Optional Specific VCOM Port (Leave blank to auto-catch on USB plug-in)" Style="{StaticResource FieldLabelStyle}" />
          <TextBox Width="220" HorizontalAlignment="Left" Text="{Binding SelectedComPort, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />

          <TextBlock Text="Detected MediaTek USB Interfaces (VID 0x0E8D)" Style="{StaticResource SectionHeadingStyle}" />
          <DataGrid ItemsSource="{Binding DetectedMtkEndpoints}" MaxHeight="165" Margin="0,0,0,12">
            <DataGrid.Columns>
              <DataGridTextColumn Header="VID:PID" Binding="{Binding VidPidDisplay}" Width="140" />
              <DataGridTextColumn Header="Mode" Binding="{Binding ClassifiedMode}" Width="165" />
              <DataGridTextColumn Header="COM Port" Binding="{Binding AssociatedComPort}" Width="95" />
              <DataGridTextColumn Header="Driver Health" Binding="{Binding DriverDiagnostics.Status}" Width="140" />
              <DataGridTextColumn Header="Interface Description" Binding="{Binding FriendlyName}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>

          <Border Background="#0F172A" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12"
                  Visibility="{Binding LastProbeResult, Converter={StaticResource NullToCollapsed}}">
            <StackPanel DataContext="{Binding LastProbeResult}">
              <TextBlock Text="{Binding ChipsetFamilySummary}" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" FontSize="14" Margin="0,0,0,6" />
              <UniformGrid Columns="4" Margin="0,0,0,8">
                <TextBlock Foreground="{StaticResource PrimaryTextBrush}">Sync: <Run Text="{Binding SyncSucceeded, Mode=OneWay}" /></TextBlock>
                <TextBlock Foreground="{StaticResource PrimaryTextBrush}">SBC (Secure Boot): <Run Text="{Binding SecureBootEnabled, Mode=OneWay}" /></TextBlock>
                <TextBlock Foreground="{StaticResource WarningAmberBrush}">SLA Required: <Run Text="{Binding SerialLinkAuthRequired, Mode=OneWay}" /></TextBlock>
                <TextBlock Foreground="{StaticResource WarningAmberBrush}">DAA Required: <Run Text="{Binding DownloadAgentAuthRequired, Mode=OneWay}" /></TextBlock>
              </UniformGrid>
              <TextBlock Text="{Binding DiagnosticMessage}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </DataTemplate>

  <!-- PAGE 7: DEDICATED META MODE PANEL (Section 2D) -->
  <DataTemplate DataType="{x:Type pages:MetaModeViewModel}">
    <StackPanel>
      <Border Style="{StaticResource FluentCardStyle}" BorderBrush="#F59E0B" BorderThickness="1.5">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Rescan META USB" Command="{Binding RefreshMetaEndpointsCommand}" Style="{StaticResource SecondaryButtonStyle}" />
          <StackPanel>
            <TextBlock Text="MediaTek META Mode — VCOM Boot &amp; Handshake" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,4" />
            <TextBlock Text="1. Power OFF the device completely (unplug USB).  2. Click 'Boot Phone to META Mode &amp; Handshake' below.  3. Log shows 'Waiting for USB device...' — plug USB cable (no buttons) so Preloader VCOM is caught and handshaken into META Mode."
                       Foreground="#FDE68A" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" />
            <TextBlock Text="{Binding ProviderInstallationStatus}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11.5" TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource FluentCardStyle}">
        <StackPanel>
          <WrapPanel Margin="0,0,0,12">
            <Button Content="🧭 Boot Phone to META Mode &amp; Handshake (Catch VCOM)"
                    Command="{Binding BootPhoneToMetaModeCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="42"
                    Padding="18,0"
                    FontSize="13.5"
                    FontWeight="Bold"
                    Margin="0,0,10,6" />
            <Button Content="Verify Selected / Connected META USB Session"
                    Command="{Binding VerifyMetaSessionCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Height="42"
                    Padding="14,0"
                    Margin="0,0,0,6" />
          </WrapPanel>

          <TextBlock Text="Recognized META USB Endpoints" Style="{StaticResource SectionHeadingStyle}" />
          <DataGrid ItemsSource="{Binding DetectedMetaEndpoints}" SelectedItem="{Binding SelectedMetaEndpoint}" MaxHeight="170" Margin="0,0,0,12">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Classification" Binding="{Binding InterfaceClassification}" Width="260" />
              <DataGridTextColumn Header="META DLL Present" Binding="{Binding ExternalCommunicationProviderAvailable}" Width="135" />
              <DataGridTextColumn Header="Reported State" Binding="{Binding ReportedState}" Width="155" />
              <DataGridTextColumn Header="USB Friendly Name" Binding="{Binding UsbDevice.FriendlyName}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>

          <Border Background="#0F172A" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10"
                  Visibility="{Binding LastDiagnostic, Converter={StaticResource NullToCollapsed}}">
            <StackPanel DataContext="{Binding LastDiagnostic}">
              <TextBlock Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" Margin="0,0,0,4">
                State: <Run Text="{Binding State, Mode=OneWay}" /> | Session Established: <Run Text="{Binding SessionEstablished, Mode=OneWay}" />
              </TextBlock>
              <TextBlock Text="{Binding DiagnosticSummary}" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <!-- Read-Only Modem / AT Baseband Inquiry -->
          <Border Background="#0F172A" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
            <StackPanel>
              <TextBlock Text="Read-Only Modem / AT Baseband Inquiry (ATI / AT+CGMI / AT+CGMM / AT+CGMR — Zero NVRAM Writes)" Style="{StaticResource FieldLabelStyle}" Foreground="{StaticResource AccentCyanBrush}" />
              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="200" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding SelectedAtComPort, UpdateSourceTrigger=PropertyChanged}" ToolTip="Modem/AT COM port (e.g. COM38, or leave blank to auto-detect)" />
                <Button Grid.Column="2" Content="📡 Read Modem / Baseband Info (AT)" Command="{Binding QueryReadOnlyAtModemCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                <TextBlock Grid.Column="4" Text="{Binding LastAtModemResult.RawSummary, Mode=OneWay}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="11.5" />
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </DataTemplate>

  <!-- PAGE 8: SPD / UNISOC TOOLS (Section 2C) -->
  <DataTemplate DataType="{x:Type pages:SpdUnisocToolsViewModel}">
    <StackPanel>
      <Border Style="{StaticResource FluentCardStyle}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Scan Unisoc USB" Command="{Binding ScanUnisocEndpointsCommand}" Style="{StaticResource SecondaryButtonStyle}" />
          <StackPanel>
            <TextBlock Text="Spreadtrum / Unisoc VCOM Download Catch &amp; Handshake" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,4" />
            <TextBlock Text="Step 1: Click 'Catch &amp; Handshake Unisoc VCOM' below (Console logs instructions + 'Waiting for USB device...'). Step 2: Power OFF phone, hold Vol- (or Vol+ &amp; Vol-), and plug USB cable to catch 1782:4D00 VCOM and handshake BSL_REP_VER."
                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource FluentCardStyle}">
        <StackPanel>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="190" />
              <ColumnDefinition Width="10" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="📡 Catch &amp; Handshake Unisoc VCOM (HDLC 0x7E)"
                    Command="{Binding ProbeDownloadBannerCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="40"
                    Padding="16,0" />
            <TextBox Grid.Column="2" Text="{Binding SelectedComPort, UpdateSourceTrigger=PropertyChanged}" ToolTip="Optional specific COM port (leave blank to auto-catch on USB plug-in)" />
            <Button Grid.Column="4" Content="🔓 Release Held VCOM" Command="{Binding ReleaseHeldUnisocPortCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="40" />
          </Grid>

          <TextBlock Text="Detected Unisoc / Spreadtrum USB Endpoints (VID 0x1782)" Style="{StaticResource SectionHeadingStyle}" />
          <DataGrid ItemsSource="{Binding DetectedUnisocEndpoints}" MaxHeight="175" Margin="0,0,0,12">
            <DataGrid.Columns>
              <DataGridTextColumn Header="VID:PID" Binding="{Binding VidPidDisplay}" Width="140" />
              <DataGridTextColumn Header="Mode" Binding="{Binding ClassifiedMode}" Width="160" />
              <DataGridTextColumn Header="COM Port" Binding="{Binding AssociatedComPort}" Width="95" />
              <DataGridTextColumn Header="Driver Status" Binding="{Binding DriverDiagnostics.Status}" Width="145" />
              <DataGridTextColumn Header="Description" Binding="{Binding FriendlyName}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>

          <Border Background="#0F172A" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12"
                  Visibility="{Binding LastProbeResult, Converter={StaticResource NullToCollapsed}}">
            <StackPanel DataContext="{Binding LastProbeResult}">
              <TextBlock Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" Margin="0,0,0,4">
                Boot Banner: <Run Text="{Binding BootRomBannerVersion, Mode=OneWay}" /> | Held Active: <Run Text="{Binding PortHeldActive, Mode=OneWay}" />
              </TextBlock>
              <TextBlock Text="{Binding DiagnosticMessage}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </DataTemplate>

  <!-- PAGE 9: DIAG AND DIAGNOSTICS (Section 2E) -->
  <DataTemplate DataType="{x:Type pages:DiagDiagnosticsViewModel}">
    <StackPanel>
      <Border Style="{StaticResource FluentCardStyle}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Scan DIAG Interfaces" Command="{Binding ScanDiagEndpointsCommand}" Style="{StaticResource SecondaryButtonStyle}" />
          <StackPanel>
            <TextBlock Text="DIAG &amp; Vendor Diagnostic Interface Panel" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,4" />
            <TextBlock Text="Identifies diagnostic chipset family before offering any operation. Never sends Qualcomm QCDM frames to MediaTek or Unisoc devices; protected NV/radio modifications are strictly prohibited."
                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource FluentCardStyle}">
        <StackPanel>
          <DataGrid ItemsSource="{Binding ClassifiedDiagEndpoints}" SelectedItem="{Binding SelectedEndpoint}" MaxHeight="200" Margin="0,0,0,12">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Protocol Family" Binding="{Binding ProtocolFamily}" Width="190" />
              <DataGridTextColumn Header="Chipset Vendor" Binding="{Binding VendorFamily}" Width="120" />
              <DataGridTextColumn Header="Port" Binding="{Binding UsbDevice.AssociatedComPort}" Width="85" />
              <DataGridTextColumn Header="Read-Only Probe" Binding="{Binding SupportsReadOnlyVersionProbe}" Width="120" />
              <DataGridTextColumn Header="Chipset Guardrail Notice" Binding="{Binding GuardrailNotice}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>

          <Button Content="Execute Documented Read-Only DIAG Version Probe" Command="{Binding RunReadOnlyVersionQueryCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
    </StackPanel>
  </DataTemplate>

  <!-- PAGE 10: BOOTLOADER MANAGER — ANDROID 16 & EARLIER (Section 5) -->
  <DataTemplate DataType="{x:Type pages:BootloaderManagerViewModel}">
    <StackPanel>
      <Border Style="{StaticResource FluentCardStyle}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Re-Assess Bootloader" Command="{Binding AssessBootloaderCommand}" Style="{StaticResource SecondaryButtonStyle}" />
          <StackPanel>
            <TextBlock Text="Bootloader Manager (Verified Profiles through Android 16)" Style="{StaticResource SectionHeadingStyle}" Margin="0,0,0,4" />
            <TextBlock Text="Supports officially permitted bootloader unlocking with mandatory factory-reset disclosure and post-unlock state verification. Android 16 itself does not guarantee unlockability."
                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource FluentCardStyle}" Visibility="{Binding CurrentAssessment, Converter={StaticResource NullToCollapsed}}">
        <StackPanel DataContext="{Binding CurrentAssessment}">
          <TextBlock Text="{Binding StatusSummary}" Foreground="{StaticResource AccentCyanBrush}" FontWeight="SemiBold" FontSize="13.5" TextWrapping="Wrap" Margin="0,0,0,10" />

          <UniformGrid Columns="3" Margin="0,0,0,12">
            <TextBlock Foreground="{StaticResource PrimaryTextBrush}">Reported State: <Run Text="{Binding ReportedLockState, Mode=OneWay}" FontWeight="Bold" /></TextBlock>
            <TextBlock Foreground="{StaticResource PrimaryTextBrush}">Active Mode: <Run Text="{Binding ActiveMode, Mode=OneWay}" /></TextBlock>
            <TextBlock Foreground="{StaticResource PrimaryTextBrush}">Android 16 Caveat: <Run Text="{Binding Android16CaveatApplies, Mode=OneWay}" /></TextBlock>
          </UniformGrid>

          <TextBlock Text="Verified Device-Specific Steps" Style="{StaticResource FieldLabelStyle}" />
          <ItemsControl ItemsSource="{Binding VerifiedInstructions}" Margin="0,0,0,10">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,2" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Background="#2D1519" BorderBrush="{StaticResource DangerRedBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
            <ItemsControl ItemsSource="{Binding DestructiveWarnings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Foreground="#FECACA" FontSize="12" TextWrapping="Wrap" Margin="0,1" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource FluentCardStyle}">
        <StackPanel>
          <TextBlock Text="Official Unlock Confirmation Phrase" Style="{StaticResource FieldLabelStyle}" />
          <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="320" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding ConfirmationInput, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="2" Content="Execute Verified Official Fastboot Unlock" Command="{Binding ExecuteOfficialUnlockCommand}" Style="{StaticResource DangerButtonStyle}" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </DataTemplate>

</ResourceDictionary>
