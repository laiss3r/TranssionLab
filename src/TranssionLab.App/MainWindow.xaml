<Window x:Class="TranssionLab.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TranssionLab Pro v1.9 — Universal Engineering &amp; VCOM Servicing Utility (English)"
        Width="1320"
        Height="780"
        MinWidth="1020"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource UiFont}">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="236" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- LEFT SIDEBAR: PERMANENT SCROLLABLE 11-MODULE OBSIDIAN NAVIGATION -->
    <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <!-- App Brand Header -->
        <Border DockPanel.Dock="Top" Padding="14,12" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Background="#0E0D12">
          <StackPanel>
            <DockPanel>
              <Border DockPanel.Dock="Right" Background="#2A1200" BorderBrush="#FF6F00" BorderThickness="1" CornerRadius="4" Padding="6,1.5" VerticalAlignment="Center">
                <TextBlock Text="v1.9 PRO" Foreground="#FF6F00" FontSize="9.5" FontWeight="Bold" />
              </Border>
              <TextBlock Text="TRANSSIONLAB" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15.5" />
            </DockPanel>
            <TextBlock Text="TECNO • INFINIX • ITEL" Foreground="#FF6F00" FontSize="10.5" FontWeight="Bold" Margin="0,3,0,0" />
            <TextBlock Text="MTK • META • SPD • ADB • FASTBOOT" Foreground="{StaticResource SecondaryTextBrush}" FontSize="9.5" Margin="0,1,0,0" />
          </StackPanel>
        </Border>

        <!-- Compact Sidebar Scroll Controls -->
        <Border DockPanel.Dock="Bottom" Padding="8,6" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Background="#0E0D12">
          <UniformGrid Columns="2">
            <Button Content="▲ Up" Click="OnSidebarScrollUpClick" Style="{StaticResource SecondaryButtonStyle}" Padding="6,3" FontSize="10.5" Margin="0,0,3,0" />
            <Button Content="▼ Down" Click="OnSidebarScrollDownClick" Style="{StaticResource SecondaryButtonStyle}" Padding="6,3" FontSize="10.5" Margin="3,0,0,0" />
          </UniformGrid>
        </Border>

        <!-- 11 Mandatory Engineering Workspaces -->
        <ListBox x:Name="SidebarNavListBox"
                 ItemsSource="{Binding PrimaryNavItems}"
                 SelectedItem="{Binding SelectedPrimaryNav}"
                 PreviewMouseWheel="OnSidebarPreviewMouseWheel"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="8,8"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="False">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="10,8" />
              <Setter Property="Margin" Value="0,2" />
              <Setter Property="Foreground" Value="#E5E7EB" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="NavBd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="NavBd" Property="Background" Value="#1E1D26" />
                        <Setter TargetName="NavBd" Property="BorderBrush" Value="#2D2C35" />
                        <Setter Property="Foreground" Value="#FFFFFF" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="NavBd" Property="Background" Value="#2B1447" />
                        <Setter TargetName="NavBd" Property="BorderBrush" Value="#A855F7" />
                        <Setter Property="Foreground" Value="#FFFFFF" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Width="24" FontSize="14.5" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Subtitle}" FontSize="9.5" Foreground="#9CA3AF" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- RIGHT WORKSPACE AREA -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ROW 0: COMPACT TERMINAL HEADER BAR (Build Config | Profile + ★ LIFETIME UNLIMITED | Live Clock + Settings Gear) -->
      <Border Grid.Row="0" Background="#131217" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="14,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.25*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="1.45*" />
          </Grid.ColumnDefinitions>

          <!-- Left: Build Config & Active Connection State -->
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding CurrentPage.PageTitle}" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" Margin="0,0,10,0" />
              <TextBlock Text="{Binding BuildConfigTitle}" Foreground="#9CA3AF" FontSize="10.5" VerticalAlignment="Bottom" Margin="0,0,0,2" />
            </StackPanel>
            <TextBlock Text="{Binding GlobalConnectionHeadline}" Foreground="#22C55E" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
          </StackPanel>

          <!-- Center: Profile Selector + ★ LIFETIME UNLIMITED Cyan Badge -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
            <Button Content="📋 Profiles"
                    Command="{Binding OpenProfilesSelectorCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="10,5"
                    FontSize="11.5"
                    Margin="0,0,8,0" />
            <Border Background="#082F49" BorderBrush="#0EA5E9" BorderThickness="1" CornerRadius="5" Padding="10,4" VerticalAlignment="Center">
              <TextBlock Text="{Binding UnlimitedStatusBadge}" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" />
            </Border>
          </StackPanel>

          <!-- Right: Auto-Catch, Read Info, Device Picker, Live System Clock & Settings Wheel (No Multi-Language Icons) -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Content="{Binding AutoCatchButtonLabel}"
                    Command="{Binding ToggleAutoCatchCommand}"
                    Style="{StaticResource EmeraldButtonStyle}"
                    Padding="9,5"
                    FontSize="11"
                    Margin="0,0,5,0" />
            <Button Content="📱 Read Info"
                    Command="{Binding GlobalReadPhoneInfoCommand}"
                    Style="{StaticResource PurpleButtonStyle}"
                    Padding="10,5"
                    FontSize="11.5"
                    Margin="0,0,5,0" />
            <ComboBox Width="136"
                      ItemsSource="{Binding ConnectedDevices}"
                      SelectedItem="{Binding SelectedDeviceItem}"
                      DisplayMemberPath="DeviceKey"
                      Margin="0,0,5,0" />
            <Button Content="Scan"
                    Command="{Binding GlobalScanDevicesCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="8,5"
                    Margin="0,0,5,0" />
            <Button Content="Console"
                    Command="{Binding ToggleConsoleCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="8,5"
                    Margin="0,0,6,0" />
            <Border Background="#1E1D26" BorderBrush="#2D2C35" BorderThickness="1" CornerRadius="5" Padding="8,4" VerticalAlignment="Center" Margin="0,0,6,0">
              <TextBlock Text="{Binding SystemClockText}" Foreground="#FFFFFF" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="Bold" />
            </Border>
            <Button Content="⚙"
                    ToolTip="Settings, USB Drivers, Profiles &amp; Audit Logs"
                    Command="{Binding OpenSettingsWheelCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="9,5"
                    FontSize="13" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ROW 1: SECONDARY MODULE NAVIGATION TABS -->
      <Border Grid.Row="1"
              Background="#16151D"
              BorderBrush="{StaticResource SubtleBorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="14,5"
              Visibility="{Binding HasMultipleSubTabs, Converter={StaticResource BoolToVis}}">
        <ListBox ItemsSource="{Binding ActiveSubTabs}"
                 SelectedItem="{Binding CurrentPage}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Margin" Value="0,2,8,2" />
              <Setter Property="Padding" Value="12,5" />
              <Setter Property="Foreground" Value="#9CA3AF" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="PillBd" Background="#131217" BorderBrush="#2D2C35" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="PillBd" Property="Background" Value="#1E1D26" />
                        <Setter Property="Foreground" Value="#FFFFFF" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="PillBd" Property="Background" Value="#082F49" />
                        <Setter TargetName="PillBd" Property="BorderBrush" Value="#0EA5E9" />
                        <Setter Property="Foreground" Value="#FFFFFF" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding IconGlyph}" Margin="0,0,6,0" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="{Binding PageTitle}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <!-- ROW 2: ACTIVE VCOM HOLD EMERALD BANNER -->
      <Border Grid.Row="2"
              Background="#052E16"
              BorderBrush="#22C55E"
              BorderThickness="0,0,0,1"
              Padding="14,6"
              Visibility="{Binding HasHeldVcomPort, Converter={StaticResource BoolToVis}}">
        <DockPanel>
          <Button DockPanel.Dock="Right"
                  Content="🔓 Release VCOM Port"
                  Command="{Binding ReleaseHeldVcomCommand}"
                  Style="{StaticResource SecondaryButtonStyle}"
                  Padding="10,4"
                  FontSize="11" />
          <TextBlock Text="{Binding HeldVcomBanner}"
                     Foreground="#DCFCE7"
                     FontWeight="Bold"
                     FontSize="12"
                     VerticalAlignment="Center" />
        </DockPanel>
      </Border>

      <!-- ROW 3: LIVE 'WAITING FOR DEVICE...' CANCELLABLE STRIP -->
      <Border Grid.Row="3"
              Background="#2A1200"
              BorderBrush="#FF6F00"
              BorderThickness="0,0,0,1"
              Padding="14,6"
              Visibility="{Binding IsWaitingForDevice, Converter={StaticResource BoolToVis}}">
        <DockPanel>
          <Button DockPanel.Dock="Right"
                  Content="🛑 STOP WAIT"
                  Command="{Binding CancelWaitingCommand}"
                  Style="{StaticResource DangerButtonStyle}"
                  Padding="12,4"
                  Margin="10,0,0,0" />
          <ProgressBar DockPanel.Dock="Right"
                       Width="115"
                       Height="7"
                       IsIndeterminate="True"
                       VerticalAlignment="Center"
                       Background="#131217"
                       Foreground="#FF6F00" />
          <TextBlock Text="⚡ 125 Hz VCOM / WinUSB Catch-and-Hold Armed — Power OFF phone &amp; plug USB cable now (or connect ADB / Fastboot)!"
                     Foreground="#FFEDD5"
                     FontWeight="SemiBold"
                     FontSize="11.5"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap" />
        </DockPanel>
      </Border>

      <!-- ROW 4: MULTI-DEVICE EXPLICIT SELECTION WARNING -->
      <Border Grid.Row="4"
              Background="#451A03"
              BorderBrush="#FF6F00"
              BorderThickness="0,0,0,1"
              Padding="14,6"
              Visibility="{Binding RequiresExplicitSelectionBanner, Converter={StaticResource BoolToVis}}">
        <TextBlock Foreground="#FEF3C7" FontWeight="SemiBold" FontSize="11.5" TextWrapping="Wrap">
          ⚠ Multiple phones connected simultaneously — select the exact target phone in the header dropdown before executing any operation.
        </TextBlock>
      </Border>

      <!-- ROW 5: MAIN WORKSPACE (LEFT) + DOCKED DARK TERMINAL CONSOLE (RIGHT) -->
      <Grid Grid.Row="5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="14,12">
          <ContentControl Content="{Binding CurrentPage}" />
        </ScrollViewer>

        <!-- Docked Jet-Black Servicing Console -->
        <Border Grid.Column="1"
                Width="334"
                Background="#0B0A0E"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="1,0,0,0"
                Visibility="{Binding IsLiveConsoleVisible, Converter={StaticResource BoolToVis}}">
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="#131217" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="10,6">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Content="Copy" Command="{Binding CopyConsoleCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="7,2" FontSize="10.5" Margin="0,0,4,0" />
                  <Button Content="Clear" Command="{Binding ClearConsoleCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="7,2" FontSize="10.5" />
                </StackPanel>
                <TextBlock Text="▶ LIVE CONSOLE (META / BROM / SPD / ADB)" Foreground="#22C55E" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
              </DockPanel>
            </Border>

            <TextBox x:Name="LiveConsoleTextBox"
                     Text="{Binding LiveConsoleText, Mode=OneWay}"
                     TextChanged="OnLiveConsoleTextChanged"
                     IsReadOnly="True"
                     Background="#0B0A0E"
                     Foreground="#86EFAC"
                     BorderThickness="0"
                     Padding="10,8"
                     FontFamily="{StaticResource MonoFont}"
                     FontSize="11"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
          </DockPanel>
        </Border>
      </Grid>

      <!-- ROW 6: 4-COLOR PIPELINE TRACKER + LOADING BAR + EMERALD READY BANNER + EMERGENCY '🛑 STOP' -->
      <Border Grid.Row="6" Background="#131217" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="14,7">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- Status Badge -->
          <Border Grid.Column="0" Background="#082F49" BorderBrush="#0EA5E9" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding StepBadgeText}" Foreground="#38BDF8" FontWeight="Bold" FontSize="10.5" FontFamily="{StaticResource MonoFont}" />
          </Border>

          <!-- Emerald Status Text + 4 Colored Process Parameters (Blue, Yellow, Orange, Green) -->
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
              <Border Background="#0C4A6E" BorderBrush="#0EA5E9" BorderThickness="1" CornerRadius="3" Padding="6,1" Margin="0,0,6,0">
                <TextBlock Text="● 1. USB DETECT" Foreground="#38BDF8" FontSize="9.5" FontWeight="Bold" />
              </Border>
              <Border Background="#422006" BorderBrush="#EAB308" BorderThickness="1" CornerRadius="3" Padding="6,1" Margin="0,0,6,0">
                <TextBlock Text="● 2. HANDSHAKE" Foreground="#FACC15" FontSize="9.5" FontWeight="Bold" />
              </Border>
              <Border Background="#431407" BorderBrush="#FF6F00" BorderThickness="1" CornerRadius="3" Padding="6,1" Margin="0,0,6,0">
                <TextBlock Text="● 3. PARTITION / I/O" Foreground="#FB923C" FontSize="9.5" FontWeight="Bold" />
              </Border>
              <Border Background="#052E16" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="3" Padding="6,1">
                <TextBlock Text="● 4. VERIFIED" Foreground="#4ADE80" FontSize="9.5" FontWeight="Bold" />
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding StepDetailText}" Foreground="#22C55E" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <!-- Active Loading Bar Pipeline -->
          <ProgressBar Grid.Column="2"
                       Width="145"
                       Height="8"
                       Minimum="0"
                       Maximum="100"
                       Value="{Binding StepProgressPercent, Mode=OneWay}"
                       Background="#1E1D26"
                       Foreground="#22C55E"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0" />

          <!-- Emergency Hardware / Wait Abort Switch -->
          <Button Grid.Column="3"
                  Content="🛑 STOP"
                  Command="{Binding EmergencyStopCommand}"
                  Style="{StaticResource DangerButtonStyle}"
                  Padding="14,6"
                  FontSize="12"
                  FontWeight="Bold"
                  VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
