<Window x:Class="TranssionLab.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TranssionLab Pro v1.8 — Universal Servicing Suite (TECNO • Infinix • itel | MTK • META • SPD • ADB)"
        Width="1280"
        Height="760"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="{StaticResource UiFont}">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="216" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- LEFT SIDEBAR: CLEAN 7-ITEM OUMSEGSM-REFERENCED NAVIGATION -->
    <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <!-- App Brand Header -->
        <Border DockPanel.Dock="Top" Padding="15,14" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1">
          <StackPanel>
            <DockPanel>
              <Border DockPanel.Dock="Right" Background="#065F46" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                <TextBlock Text="v1.8 PRO" Foreground="#A7F3D0" FontSize="9.5" FontWeight="Bold" />
              </Border>
              <TextBlock Text="TranssionLab" Foreground="#FFFFFF" FontWeight="Bold" FontSize="17" />
            </DockPanel>
            <TextBlock Text="TECNO • Infinix • itel" Foreground="{StaticResource AccentCyanBrush}" FontSize="11.5" FontWeight="SemiBold" Margin="0,3,0,0" />
            <TextBlock Text="MTK • SPD • ADB • Fastboot" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10.5" Margin="0,1,0,0" />
          </StackPanel>
        </Border>

        <!-- Compact Sidebar Scroll Buttons -->
        <Border DockPanel.Dock="Bottom" Padding="8,6" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Background="#090E19">
          <UniformGrid Columns="2">
            <Button Content="▲ Up" Click="OnSidebarScrollUpClick" Style="{StaticResource SecondaryButtonStyle}" Padding="6,4" FontSize="11" Margin="0,0,3,0" />
            <Button Content="▼ Down" Click="OnSidebarScrollDownClick" Style="{StaticResource SecondaryButtonStyle}" Padding="6,4" FontSize="11" Margin="3,0,0,0" />
          </UniformGrid>
        </Border>

        <!-- 7 Primary Workspaces (OumseGsm Reference: Home, Read Info, MTK, SPD, ADB, Firmware, Settings) -->
        <ListBox x:Name="SidebarNavListBox"
                 ItemsSource="{Binding PrimaryNavItems}"
                 SelectedItem="{Binding SelectedPrimaryNav}"
                 PreviewMouseWheel="OnSidebarPreviewMouseWheel"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="10,10"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="False">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="12,10" />
              <Setter Property="Margin" Value="0,3" />
              <Setter Property="Foreground" Value="#CBD5E1" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="NavBd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="NavBd" Property="Background" Value="#1E293B" />
                        <Setter Property="Foreground" Value="#FFFFFF" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="NavBd" Property="Background" Value="#2563EB" />
                        <Setter Property="Foreground" Value="#FFFFFF" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Width="26" FontSize="16" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="Bold" />
                  <TextBlock Text="{Binding Subtitle}" FontSize="10" Opacity="0.78" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- RIGHT WORKSPACE AREA -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ROW 0: CLEAN TOP HEADER BAR -->
      <Border Grid.Row="0" Background="#0F172A" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="16,9">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="{Binding AutoCatchButtonLabel}"
                    Command="{Binding ToggleAutoCatchCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Background="#064E3B"
                    BorderBrush="#10B981"
                    Foreground="#A7F3D0"
                    Padding="10,6"
                    FontSize="11.5"
                    Margin="0,0,6,0" />
            <Button Content="📱 Read Info"
                    Command="{Binding GlobalReadPhoneInfoCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Background="#059669"
                    BorderBrush="#34D399"
                    Padding="12,6"
                    FontSize="12"
                    Margin="0,0,6,0" />
            <ComboBox Width="168"
                      ItemsSource="{Binding ConnectedDevices}"
                      SelectedItem="{Binding SelectedDeviceItem}"
                      DisplayMemberPath="DeviceKey"
                      Margin="0,0,6,0" />
            <Button Content="Scan"
                    Command="{Binding GlobalScanDevicesCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="10,6"
                    Margin="0,0,6,0" />
            <Button Content="Console"
                    Command="{Binding ToggleConsoleCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="10,6" />
          </StackPanel>

          <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding CurrentPage.PageTitle}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="16.5" FontWeight="Bold" />
            <TextBlock Text="{Binding GlobalConnectionHeadline}" Foreground="{StaticResource AccentCyanBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- ROW 1: HORIZONTAL SUB-TAB PILLS BAR (OumseGsm Top Module Pills) -->
      <Border Grid.Row="1"
              Background="#0B1322"
              BorderBrush="{StaticResource SubtleBorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="14,6"
              Visibility="{Binding HasMultipleSubTabs, Converter={StaticResource BoolToVis}}">
        <ListBox ItemsSource="{Binding ActiveSubTabs}"
                 SelectedItem="{Binding CurrentPage}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Margin" Value="0,2,8,2" />
              <Setter Property="Padding" Value="13,6" />
              <Setter Property="Foreground" Value="#CBD5E1" />
              <Setter Property="Cursor" Value="Hand" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="PillBd" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="PillBd" Property="Background" Value="#283548" />
                        <Setter Property="Foreground" Value="#FFFFFF" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="PillBd" Property="Background" Value="#2563EB" />
                        <Setter TargetName="PillBd" Property="BorderBrush" Value="#60A5FA" />
                        <Setter Property="Foreground" Value="#FFFFFF" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding IconGlyph}" Margin="0,0,6,0" FontSize="12.5" VerticalAlignment="Center" />
                <TextBlock Text="{Binding PageTitle}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <!-- ROW 2: ACTIVE VCOM HOLD GREEN BANNER (Proves phone is held out of battery charging!) -->
      <Border Grid.Row="2"
              Background="#064E3B"
              BorderBrush="#10B981"
              BorderThickness="0,0,0,1"
              Padding="16,7"
              Visibility="{Binding HasHeldVcomPort, Converter={StaticResource BoolToVis}}">
        <DockPanel>
          <Button DockPanel.Dock="Right"
                  Content="🔓 Release VCOM Port"
                  Command="{Binding ReleaseHeldVcomCommand}"
                  Style="{StaticResource SecondaryButtonStyle}"
                  Padding="10,4"
                  FontSize="11.5" />
          <TextBlock Text="{Binding HeldVcomBanner}"
                     Foreground="#ECFDF5"
                     FontWeight="Bold"
                     FontSize="12.5"
                     VerticalAlignment="Center" />
        </DockPanel>
      </Border>

      <!-- ROW 3: LIVE 'WAITING FOR DEVICE...' CANCELLABLE STRIP -->
      <Border Grid.Row="3"
              Background="#0C4A6E"
              BorderBrush="{StaticResource AccentCyanBrush}"
              BorderThickness="0,0,0,1"
              Padding="16,7"
              Visibility="{Binding IsWaitingForDevice, Converter={StaticResource BoolToVis}}">
        <DockPanel>
          <Button DockPanel.Dock="Right"
                  Content="⛔ Stop"
                  Command="{Binding CancelWaitingCommand}"
                  Style="{StaticResource DangerButtonStyle}"
                  Padding="12,4"
                  Margin="10,0,0,0" />
          <ProgressBar DockPanel.Dock="Right"
                       Width="110"
                       Height="7"
                       IsIndeterminate="True"
                       VerticalAlignment="Center"
                       Background="#082F49"
                       Foreground="{StaticResource AccentCyanBrush}" />
          <TextBlock Text="⚡ 125 Hz VCOM / WinUSB Catch-and-Hold Active — Power OFF phone &amp; plug USB cable now (or connect ADB/Fastboot)!"
                     Foreground="#E0F2FE"
                     FontWeight="SemiBold"
                     FontSize="12"
                     VerticalAlignment="Center"
                     TextWrapping="Wrap" />
        </DockPanel>
      </Border>

      <!-- ROW 4: MULTI-DEVICE EXPLICIT SELECTION WARNING -->
      <Border Grid.Row="4"
              Background="#78350F"
              BorderBrush="#F59E0B"
              BorderThickness="0,0,0,1"
              Padding="16,7"
              Visibility="{Binding RequiresExplicitSelectionBanner, Converter={StaticResource BoolToVis}}">
        <TextBlock Foreground="#FEF3C7" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap">
          ⚠ Multiple phones connected simultaneously — select the exact target phone in the dropdown above before running operations.
        </TextBlock>
      </Border>

      <!-- ROW 5: MAIN WORKSPACE (LEFT) + ALWAYS-VISIBLE CONSOLE TERMINAL (RIGHT) -->
      <Grid Grid.Row="5">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,14">
          <ContentControl Content="{Binding CurrentPage}" />
        </ScrollViewer>

        <!-- Docked Live Servicing Console -->
        <Border Grid.Column="1"
                Width="320"
                Background="#060A11"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="1,0,0,0"
                Visibility="{Binding IsLiveConsoleVisible, Converter={StaticResource BoolToVis}}">
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="#0F172A" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="10,7">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Content="Copy" Command="{Binding CopyConsoleCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="7,2" FontSize="11" Margin="0,0,5,0" />
                  <Button Content="Clear" Command="{Binding ClearConsoleCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="7,2" FontSize="11" />
                </StackPanel>
                <TextBlock Text="⚡ LIVE CONSOLE" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" />
              </DockPanel>
            </Border>

            <TextBox x:Name="LiveConsoleTextBox"
                     Text="{Binding LiveConsoleText, Mode=OneWay}"
                     TextChanged="OnLiveConsoleTextChanged"
                     IsReadOnly="True"
                     Background="#060A11"
                     Foreground="#A7F3D0"
                     BorderThickness="0"
                     Padding="10,8"
                     FontFamily="{StaticResource MonoFont}"
                     FontSize="11"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
          </DockPanel>
        </Border>
      </Grid>

      <!-- ROW 6: PINNED BOTTOM STEP PROGRESS BAR -->
      <Border Grid.Row="6" Background="#090E17" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="14,7">
        <DockPanel>
          <Border DockPanel.Dock="Left" Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding StepBadgeText}" Foreground="#38BDF8" FontWeight="Bold" FontSize="10.5" FontFamily="{StaticResource MonoFont}" />
          </Border>
          <ProgressBar DockPanel.Dock="Right"
                       Width="135"
                       Height="7"
                       Minimum="0"
                       Maximum="100"
                       Value="{Binding StepProgressPercent, Mode=OneWay}"
                       Background="#1E293B"
                       Foreground="#10B981"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0" />
          <TextBlock Text="{Binding StepDetailText}" Foreground="#E2E8F0" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
