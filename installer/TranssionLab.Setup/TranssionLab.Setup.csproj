<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AssemblyName>TranssionLab-Setup</AssemblyName>
    <RootNamespace>TranssionLab.Setup</RootNamespace>
    <ApplicationIcon>..\..\src\TranssionLab.App\Assets\TranssionLab.ico</ApplicationIcon>
    <ApplicationManifest>setup.manifest</ApplicationManifest>
    <AssemblyTitle>TranssionLab Universal Android Servicing Suite Setup</AssemblyTitle>
    <Description>Native 64-bit Windows First-Time Setup Wizard for TranssionLab Universal Android Servicing Suite</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup Condition="'$(BundleZipPath)' != '' and Exists('$(BundleZipPath)')">
    <EmbeddedResource Include="$(BundleZipPath)" LogicalName="TranssionLabBundle.zip" />
  </ItemGroup>
</Project>
